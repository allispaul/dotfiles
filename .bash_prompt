#! /usr/bin/env false
# Note, this script should be source'd, not invoked as a command.
# Therefore, invocation as a command returns an error code 1.

if [ -z "$PS1ORIG" ]; then
  export PS1ORIG="$PS1"
fi

# ---------------------------------------------------------------------------
# Renders a two-line prompt:
#
#     <blank line>
#     [ 0 ] user@host ~/some/path                      <- reverse-video bar
#     $ _                                              <- you type here
#
# The bar uses reverse video (SGR 7) rather than a foreground colour, because
# reverse video is something ordinary command output almost never emits.
# ---------------------------------------------------------------------------

__build_prompt() {
  # Must be the very first line: it captures the exit status of whatever the
  # user just ran, before anything in here overwrites it.
  local status=$?

  # Each fragment below is complete and ready to concatenate.  The \[ ... \]
  # markers tell bash "the bytes in here occupy zero columns"; without them
  # bash miscounts the prompt width, and long command lines wrap in the wrong
  # place while Ctrl-R redraws garbage.
  #
  # PS1 itself understands \e, so we can hand it the two characters \ and e
  # verbatim.
  local plain='\[\e[0m\]'       # reset all attributes
  local bar='\[\e[7;1m\]'
  local barbold='\[\e[7;1m\]'   # reverse video, bold (root)
  local ok='\[\e[30;42m\]'      # black on green
  local err='\[\e[97;41m\]'     # bright white on red
  local clreol='\[\e[K\]'       # erase to end of line

  # Pick the badge colour from the exit status.
  local badgecolor
  if [ "$status" -eq 0 ]; then
    badgecolor="$ok"
  else
    badgecolor="$err"
  fi

  # Pick the bar weight from the user.
  local barcolor
  if [ "$EUID" -eq 0 ]; then
    barcolor="$barbold"
  else
    barcolor="$bar"
  fi

  # Assemble
  local badge="${badgecolor} ${status} ${plain}"
  local info="${barcolor} \u@\h \w ${plain}"

  # clreol keeps the bar's trailing edge clean after a window resize.
  # The final \$ is single-quoted so it survives as a prompt escape (# for
  # root, $ otherwise) instead of being eaten as a variable reference.
  PS1="${plain}\n${badge}${info}${clreol}\n"'\$ '
}

default_prompt() {
  export PS1="$PS1ORIG"
  unset PROMPT_COMMAND PS1ORIG
}

export PROMPT_COMMAND="__build_prompt"
export -f __build_prompt default_prompt
